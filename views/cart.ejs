<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carrito - Tienda Electrónica</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <a href="/" class="logo">TIENDA DNA</a>
            <div class="nav-links">
                <a href="/">🏠 Inicio</a>
                <a href="/cart" class="cart-icon">🛒 Carrito</a>
                <a href="/orders">📦 Mis Pedidos</a>
                <a href="/auth/logout">🚪 Salir</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="card">
            <h1>🛒 Mi Carrito</h1>
        </div>

        <% if (message) { %>
            <div class="alert alert-success"><%= message %></div>
        <% } %>

        <% if (error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>

        <% if (items && items.length > 0) { %>
            <div class="cart-items">
                <% items.forEach(item => { %>
                    <div class="cart-item card">
                        <div class="cart-item-image">
                            <% if (item.image) { %>
                                <img src="/uploads/<%= item.image %>" alt="<%= item.name %>">
                            <% } else { %>
                                💻
                            <% } %>
                        </div>
                        <div class="cart-item-info">
                            <h3><%= item.name %></h3>
                            <p class="price">$<%= parseFloat(item.price).toFixed(2) %></p>
                        </div>
                        <div class="cart-item-quantity">
                            <form method="POST" action="/cart/update/<%= item.id %>" style="display: inline;">
                                <input type="hidden" name="action" value="decrease">
                                <button type="submit" class="btn-small">-</button>
                            </form>
                            <span class="quantity"><%= item.quantity %></span>
                            <form method="POST" action="/cart/update/<%= item.id %>" style="display: inline;">
                                <input type="hidden" name="action" value="increase">
                                <button type="submit" class="btn-small">+</button>
                            </form>
                        </div>
                        <div class="cart-item-subtotal">
                            <p>$<%= (parseFloat(item.price) * item.quantity).toFixed(2) %></p>
                        </div>
                        <form method="POST" action="/cart/update/<%= item.id %>">
                            <input type="hidden" name="action" value="remove">
                            <button type="submit" class="btn-danger">🗑️</button>
                        </form>
                    </div>
                <% }) %>
            </div>

            <div class="cart-summary card">
                <h2>Total: $<%= parseFloat(total).toFixed(2) %></h2>
                <form method="POST" action="/orders/checkout">
                    <button type="submit" class="btn" style="width: 100%; margin-top: 15px;">
                        💳 Proceder al Pago
                    </button>
                </form>
            </div>
        <% } else { %>
            <div class="empty-state">
                <div class="empty-state-icon">🛒</div>
                <h2>Tu carrito está vacío</h2>
                <p>Agrega productos para comenzar a comprar</p>
                <a href="/" class="btn" style="margin-top: 20px;">Ver Productos</a>
            </div>
        <% } %>
    </div>

    <%- include('partials/chatbot') %>
</body>
</html>
