<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión - Tienda</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <a href="/" class="logo">TIENDA DNA</a>
            <div class="nav-links">
                <a href="/">🏠 Inicio</a>
                <a href="/auth/login">🔐 Iniciar Sesión</a>
                <a href="/auth/register">Registrarse</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="auth-container">
            <div class="card">
                <h1>Iniciar Sesión</h1>

                <% if (error) { %>
                    <div class="alert alert-error"><%= error %></div>
                <% } %>

                <% if (message) { %>
                    <div class="alert alert-success"><%= message %></div>
                <% } %>

                <form method="POST" action="/auth/login" class="form">
                    <div class="form-group">
                        <label for="email">Correo electrónico</label>
                        <input type="email" id="email" name="email" required placeholder="tu@email.com">
                    </div>

                    <div class="form-group">
                        <label for="password">Contraseña</label>
                        <input type="password" id="password" name="password" required placeholder="Tu contraseña">
                    </div>

                    <button type="submit" class="btn" style="width: 100%;">Iniciar Sesión</button>
                </form>

                <p style="text-align: center; margin-top: 20px;">
                    ¿No tienes cuenta? <a href="/auth/register">Regístrate aquí</a>
                </p>
            </div>
        </div>
    </div>
</body>
</html>
