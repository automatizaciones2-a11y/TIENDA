<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mis Pedidos - Tienda Electrónica</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <a href="/" class="logo">TIENDA DNA</a>
            <div class="nav-links">
                <a href="/">🏠 Inicio</a>
                <a href="/cart">🛒 Carrito</a>
                <a href="/orders">📦 Mis Pedidos</a>
                <a href="/auth/logout">🚪 Salir</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="card">
            <h1>📦 Mis Pedidos</h1>
        </div>

        <% if (message) { %>
            <div class="alert alert-success"><%= message %></div>
        <% } %>

        <% if (error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>

        <% if (orders && orders.length > 0) { %>
            <% orders.forEach(order => { %>
                <div class="card order-card">
                    <div class="order-header">
                        <h3>Pedido #<%= order.id %></h3>
                        <span class="order-status status-<%= order.status.toLowerCase() %>">
                            <%= order.status %>
                        </span>
                    </div>
                    <p class="order-date">
                        📅 <%= new Date(order.created_at).toLocaleDateString('es-ES', {
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric',
                            hour: '2-digit',
                            minute: '2-digit'
                        }) %>
                    </p>

                    <div class="order-items">
                        <% if (order.items) { %>
                            <% order.items.forEach(item => { %>
                                <div class="order-item">
                                    <span><%= item.product_name %> x<%= item.quantity %></span>
                                    <span>$<%= (parseFloat(item.price) * item.quantity).toFixed(2) %></span>
                                </div>
                            <% }) %>
                        <% } %>
                    </div>

                    <div class="order-total">
                        <strong>Total: $<%= parseFloat(order.total).toFixed(2) %></strong>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="empty-state">
                <div class="empty-state-icon">📦</div>
                <h2>No tienes pedidos</h2>
                <p>Cuando realices una compra, aparecerá aquí</p>
                <a href="/" class="btn" style="margin-top: 20px;">Ver Productos</a>
            </div>
        <% } %>
    </div>

    <%- include('partials/chatbot') %>
</body>
</html>
